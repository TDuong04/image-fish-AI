# Run outputs: keep the provenance, drop the artifacts.
# Exclude the heavy files directly -- a broad /runs/** exclusion cannot be
# undone by negations, because git will not descend into an excluded directory.
/runs/**/weights/
/runs/**/*.jpg
/runs/**/*.png
/runs/**/*.csv
/runs/**/*.yaml.bak

*.pt
*.pth
*.onnx
*.engine
*.weights
*.tar
*.zip
