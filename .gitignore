__pycache__/
*.pyc
.venv/

# Datasets and downloads (root-anchored: configs/data/ must stay tracked)
/data/
/fish-research/
/models/

# Run outputs: keep the provenance, drop the artifacts.
# Exclude the heavy files directly -- a broad /runs/** exclusion cannot be
# undone by negations, because git will not descend into an excluded directory.
/runs/**/weights/
/runs/**/*.jpg
/runs/**/*.png
# results.csv is the epoch-by-epoch curve -- ~15 KB and the only evidence that
# a run converged rather than being truncated. Keep it.
/runs/**/*.yaml.bak

*.pt
*.pth
*.onnx
*.engine
*.weights
*.tar
*.zip

# Personal files that are not part of this project
creativity_marks_appeal.md

# Supervisor/runner scratch state is per-machine and must NOT be committed:
# a clone otherwise ships one machine's old failures, and kaggle_report.json
# reports them as if the remote session had just produced them.
/runs/_supervisor/
/runs/_kaggle/

# Demo media: derived from the dataset and large. demo/app.py regenerates
# a sample clip from consecutive DeepFish frames in a few seconds.
*.mp4
/demo/demo_data.json
/demo/device_data.json
